<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%SectionTitle}">
        <f:entry title="${%ReturnUrl}" field="returnUrl">
            <f:textbox/>
        </f:entry>
        <f:entry title="${%TokenId}" field="tokenId">
            <f:textbox/>
        </f:entry>
    </f:section>
</j:jelly>
