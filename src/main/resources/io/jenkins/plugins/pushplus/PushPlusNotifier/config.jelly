<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">

    <f:entry title="发送渠道" field="channel">
        <f:select/>
    </f:entry>

    <f:entry title="群组编码(可选)" field="topic">
        <f:textbox/>
    </f:entry>

    <f:entry title="好友令牌(可选)" field="to">
        <f:textbox/>
    </f:entry>

    <f:entry title="Webhook编码(可选)" field="webhook">
        <f:textbox/>
    </f:entry>

</j:jelly>
